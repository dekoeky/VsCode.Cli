    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<RootNamespace>dekoeky</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="testfiles\c#\Goodbye.cs" />
    <Compile Remove="testfiles\c#\Greeting.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="testfiles\c#\Goodbye.cs">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
